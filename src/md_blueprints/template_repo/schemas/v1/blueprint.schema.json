{
  "$id": "blueprint.schema.json",
  "type": "object",
  "required": ["schemaVersion", "name", "title", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "variables": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/targetOverride" }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/input" }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/output" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shares": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/share" }
        },
        "flights": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/flight" }
        },
        "dives": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/dive" }
        },
        "context": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/context" }
        },
        "guides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/guide" }
        },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/role" }
        }
      }
    }
  },
  "$defs": {
    "variable": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["default"],
          "properties": {
            "description": { "type": "string" },
            "default": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "targetOverride": {
      "type": "object",
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": ["blueprint", "output"],
      "additionalProperties": false,
      "properties": {
        "blueprint": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "required": ["share"],
      "additionalProperties": false,
      "properties": {
        "share": { "type": "string", "minLength": 1 }
      }
    },
    "share": {
      "type": "object",
      "required": ["name", "database"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "access": { "type": "string" },
        "visibility": { "type": "string" },
        "includePattern": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "grants": { "$ref": "#/$defs/grants" },
        "cleanup": { "type": "boolean" },
        "dropDatabase": { "type": "boolean" },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    },
    "flight": {
      "type": "object",
      "required": ["name", "source", "requirements"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "requirements": { "type": "string", "minLength": 1 },
        "scheduleCron": { "type": "string" },
        "accessTokenName": { "type": "string" },
        "maxRuntimeSec": { "type": "integer", "minimum": 0 },
        "runOnDeploy": { "type": "boolean" },
        "waitForRun": {
          "enum": ["success", false]
        },
        "secrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "config": {
          "type": "object",
          "additionalProperties": {}
        },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    },
    "dive": {
      "type": "object",
      "required": ["title", "source", "requiredResources"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "ready", "endorsed", "archived"] },
        "requiredResources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requiredResource" }
        },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    },
    "requiredResource": {
      "type": "object",
      "required": ["alias"],
      "oneOf": [
        { "required": ["share"] },
        { "required": ["url"] },
        { "required": ["input"] }
      ],
      "additionalProperties": false,
      "properties": {
        "share": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "deploy": { "type": "boolean" },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    },
    "guide": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "topic": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^$|^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "source": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 1024 },
        "access": { "enum": ["user", "organization"] },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/guideReference" }
        },
        "changeComment": { "type": "string", "maxLength": 1024 },
        "externalId": { "type": "string", "maxLength": 255 },
        "deploy": { "type": "boolean" },
        "cleanup": { "type": "boolean" },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    },
    "guideReference": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["catalog", "dive", "flight", "guide"] },
        "blueprint": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "format": "uuid" },
        "url": { "type": "string", "minLength": 1 },
        "share": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 },
        "view": { "type": "string", "minLength": 1 },
        "macro": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "users": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "mode": { "enum": ["additive", "authoritative"] }
      }
    },
    "role": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "includedRoles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "mode": { "enum": ["additive", "authoritative"] },
        "deploy": { "type": "boolean" },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/targetOverride" }
        }
      }
    }
  }
}
