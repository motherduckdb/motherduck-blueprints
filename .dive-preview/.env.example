# Local Dive preview only reads data. Use your personal token from
# https://app.motherduck.com → Settings → API Tokens.
# Choose a read/write token: read scaling tokens cannot attach the shares a Dive requires.
# Keep this file out of Git. CI deploys with the service-account token stored as
# MOTHERDUCK_TOKEN in the target's GitHub Environment, not this token.
VITE_MOTHERDUCK_TOKEN=your_token_here
